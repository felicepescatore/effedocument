<?xml version="1.0" encoding="UTF-8"?>
<!--
  eFFe Document - protezioni per IIS (hosting Windows).
  Equivalente dei file .htaccess, che IIS ignora.
-->
<configuration>
  <system.webServer>
    <defaultDocument>
      <files>
        <clear />
        <add value="index.php" />
      </files>
    </defaultDocument>
    <security>
      <requestFiltering>
        <hiddenSegments>
          <!-- credenziali del database -->
          <add segment="effeconfig.xml" />
          <!-- file di configurazione per altri server -->
          <add segment=".htaccess" />
          <add segment=".user.ini" />
        </hiddenSegments>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
