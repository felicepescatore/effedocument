# eFFe Document - impostazioni PHP richieste (Apache con mod_php)
# Con PHP-FPM queste righe vanno rimosse: valgono quelle in .user.ini
<IfModule mod_php.c>
    php_value output_buffering 4096
    php_value default_charset "ISO-8859-1"
</IfModule>
<IfModule mod_php7.c>
    php_value output_buffering 4096
    php_value default_charset "ISO-8859-1"
</IfModule>

# Il file di configurazione contiene le credenziali del database
<Files "effeconfig.xml">
    Require all denied
</Files>

# File di configurazione per IIS: su Apache non servono e non vanno mostrati
<Files "web.config">
    Require all denied
</Files>
