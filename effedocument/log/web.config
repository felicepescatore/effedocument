<?xml version="1.0" encoding="UTF-8"?>
<!-- eFFe Document - i log non devono essere accessibili dal web (IIS) -->
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <fileExtensions allowUnlisted="false" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
